{
  "name": "keymapsync",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based Vial keymap sync for multiple keyboards",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:electron": "vite build --mode electron",
    "build:tauri": "vite build --mode tauri",
    "tauri": "tauri",
    "build:web": "vite build --mode web",
    "preview:web": "vite preview --mode web",
    "test": "node --test \"app/test/*.test.js\"",
    "test:e2e": "vite build --mode web && node app/test/e2e/web-e2e.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "playwright-core": "^1.56.1",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "xz-decompress": "^0.2.3"
  }
}
